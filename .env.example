# Copy to .env.local for local dev. Both are safe in a bundle: the anon key is
# an identifier, not a secret — row-level security is what protects the data.
#
# On Vercel these go in Settings → Environment Variables, not in the repo.
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Never put the service_role key anywhere near this file or the client. It
# bypasses RLS entirely; nothing in this app needs it.
